# CognoDB Cloud Connection Credentials
# Create a free instance at https://console.cognodb.com
# Username for CognoDB is "cognodb"

COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your-generated-password-here

# Optional: Set to 'true' to force Mock Sandbox mode if running without CognoDB instance
FORCE_MOCK_MODE=false
